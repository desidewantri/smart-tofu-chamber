# false = pakai backend asli, true = data tiruan di browser (tanpa backend)
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost:5000
# (Opsional) Client ID Google. Biasanya cukup diisi di backend (GOOGLE_CLIENT_ID);
# frontend mengambilnya otomatis dari GET /api/auth/config.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
