# Caddy: HTTPS otomatis (Let's Encrypt/ZeroSSL) untuk domain di DOMAIN.
# /api/*  -> backend, selain itu -> frontend (satu domain, tanpa masalah CORS).
{$DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy backend:5000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# Aplikasi lain di VPS yang sama: GamaTutor (folder ~/gamatutor, compose sendiri).
# Isi GT_DOMAIN di .env server. Bila tidak diisi, dipakai gamatutor.localhost (tidak berpengaruh ke internet).
{$GT_DOMAIN:gamatutor.localhost} {
	encode zstd gzip
	reverse_proxy gamatutor:3000
}
