# ====== Server ======
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ====== MongoDB ======
MONGODB_URI=mongodb://127.0.0.1:27017/smart_tofu_chamber

# ====== Auth ======
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Kunci untuk POST /api/sensor (fallback HTTP dari perangkat/simulator).
# Kosongkan untuk mematikan pengecekan.
DEVICE_API_KEY=dev-device-key

# ====== MQTT (Mosquitto) ======
MQTT_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=smartchamber/sensor/+

# ====== ML Service (FastAPI milik teman) ======
# mock : selalu pakai model tiruan di backend (default, tidak butuh ml-service)
# live : wajib memanggil ML service; kalau gagal, prediksi tidak disimpan
# auto : coba ML service, kalau gagal jatuh ke mock
ML_MODE=mock
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=3000

# ====== Notifikasi WhatsApp (Fonnte) ======
# 1) Daftar di https://fonnte.com, tambah perangkat, scan QR dengan nomor WA pengirim.
# 2) Salin token perangkat ke FONNTE_TOKEN di bawah, lalu jalankan ulang backend.
# 3) Di aplikasi: Pengaturan > Notifikasi > WhatsApp, isi nomor tujuan dan aktifkan.
WA_PROVIDER=fonnte
FONNTE_TOKEN=
# true = tidak benar-benar mengirim, pesan hanya dicetak di terminal (untuk uji tanpa token)
WA_DRY_RUN=false
# Seberapa sering status chamber diperiksa untuk notifikasi (detik)
WA_CHECK_INTERVAL_SEC=60
