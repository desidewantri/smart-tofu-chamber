# ====== Server ======
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ====== MongoDB ======
MONGODB_URI=mongodb://127.0.0.1:27017/smart_tofu_chamber

# ====== Auth ======
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Kunci untuk POST /api/sensor (fallback HTTP dari perangkat/simulator).
# Kosongkan untuk mematikan pengecekan.
DEVICE_API_KEY=dev-device-key

# ====== MQTT (Mosquitto) ======
MQTT_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=smartchamber/sensor/+
# Di server: user "backend" dari file password Mosquitto. Kosongkan di laptop.
MQTT_CLIENT_ID=toscha-backend

# ====== ML Service (FastAPI milik teman) ======
# mock : selalu pakai model tiruan di backend (default, tidak butuh ml-service)
# live : wajib memanggil ML service; kalau gagal, prediksi tidak disimpan
# auto : coba ML service, kalau gagal jatuh ke mock
ML_MODE=mock
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=3000

# ====== Notifikasi WhatsApp (Fonnte) ======
# 1) Daftar di https://fonnte.com, tambah perangkat, scan QR dengan nomor WA pengirim.
# 2) Salin token perangkat ke FONNTE_TOKEN di bawah, lalu jalankan ulang backend.
# 3) Di aplikasi: Pengaturan > Notifikasi > WhatsApp, isi nomor tujuan dan aktifkan.
WA_PROVIDER=fonnte
FONNTE_TOKEN=
# true = tidak benar-benar mengirim, pesan hanya dicetak di terminal (untuk uji tanpa token)
WA_DRY_RUN=false
# Seberapa sering status chamber diperiksa untuk notifikasi (detik)
WA_CHECK_INTERVAL_SEC=60

# ====== Akun & login ======
# true = siapa pun bisa membuat akun di halaman Daftar; false = pendaftaran ditutup
ALLOW_REGISTRATION=true
# Client ID OAuth Google (Google Cloud Console > APIs & Services > Credentials).
# Kosongkan untuk menyembunyikan tombol "Masuk dengan Google".
GOOGLE_CLIENT_ID=

# ====== Impor data dari Google Sheet (opsional) ======
# Isi dengan link Google Sheet (Share > "Anyone with the link" > Viewer), atau link CSV dari
# File > Share > Publish to web. Skema baru: received_at, sample_id, sampled_at,
# temp1, humid1, tvoc1, temp2, humid2, tvoc2, vbat. Skema lama (timestamp, ...)
# tetap didukung. Cursor sekarang per sumber: sheet:<spreadsheetId>:<gid>:<chamber>.
SHEET_URL=
SHEET_POLL_SEC=60
# Format tanggal di Sheet: mdy = 10/22/2026, dmy = 22/10/2026
SHEET_DATE_ORDER=mdy
SHEET_TZ_OFFSET=+07:00
# Opsional: hanya impor baris sejak waktu ini
SHEET_IMPORT_SINCE=
# primary  = semua baris baru di Sheet dicoba diimpor; duplikat MQTT ditolak oleh eventId.
# fallback = sama, tetapi baris lama tanpa sample_id memakai pemeriksaan kedekatan waktu.
# Untuk firmware baru yang selalu mengirim sample_id, kedua mode menghasilkan satu dokumen per event.
SHEET_MODE=fallback
# (mode fallback) tunggu sekian detik sebelum memeriksa baris Sheet, dan selisih waktu yang dianggap data sama
SHEET_FALLBACK_GRACE_SEC=180
SHEET_FALLBACK_MATCH_SEC=150
# Wajib saat memigrasikan cursor lama sheet:1/sheet:2 ke cursor per sumber.
# Isi dengan identitas sumber lama, mis. e:<publishedId>:<gid> untuk URL publish lama.
# Tanpa nilai ini importer menolak memakai cursor lama (LEGACY_CURSOR_UNMAPPED).
SHEET_LEGACY_SOURCE_ID=

# ====== SSA / RSL Engine (statistik, terpisah dari ML_MODE) ======
# Layanan Python internal. Jangan diekspos ke internet.
RSL_ENABLED=true
RSL_SERVICE_URL=http://127.0.0.1:8001
RSL_TIMEOUT_MS=2500
# Default domain untuk chamber tahu kering. Nilai eksplisit WATER/UNKNOWN tidak
# akan menghasilkan estimasi DRY.
RSL_DEFAULT_STORAGE_CONDITION=DRY
# Worker rekonsiliasi snapshot RSL (detik) dan batas batch per putaran.
RSL_SNAPSHOT_RECOVERY_INTERVAL_SEC=60
RSL_SNAPSHOT_RECOVERY_MAX_BATCH=10
