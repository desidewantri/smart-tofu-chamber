# ====== Server ======
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ====== MongoDB ======
MONGODB_URI=mongodb://127.0.0.1:27017/smart_tofu_chamber

# ====== Auth ======
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Kunci untuk POST /api/sensor (fallback HTTP dari perangkat/simulator).
# Kosongkan untuk mematikan pengecekan.
DEVICE_API_KEY=dev-device-key

# ====== MQTT (Mosquitto) ======
MQTT_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=smartchamber/sensor/+

# ====== ML Service (FastAPI milik teman) ======
# mock : selalu pakai model tiruan di backend (default, tidak butuh ml-service)
# live : wajib memanggil ML service; kalau gagal, prediksi tidak disimpan
# auto : coba ML service, kalau gagal jatuh ke mock
ML_MODE=mock
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=3000

# ====== Notifikasi WhatsApp (Fonnte) ======
# 1) Daftar di https://fonnte.com, tambah perangkat, scan QR dengan nomor WA pengirim.
# 2) Salin token perangkat ke FONNTE_TOKEN di bawah, lalu jalankan ulang backend.
# 3) Di aplikasi: Pengaturan > Notifikasi > WhatsApp, isi nomor tujuan dan aktifkan.
WA_PROVIDER=fonnte
FONNTE_TOKEN=
# true = tidak benar-benar mengirim, pesan hanya dicetak di terminal (untuk uji tanpa token)
WA_DRY_RUN=false
# Seberapa sering status chamber diperiksa untuk notifikasi (detik)
WA_CHECK_INTERVAL_SEC=60

# ====== Akun & login ======
# true = siapa pun bisa membuat akun di halaman Daftar; false = pendaftaran ditutup
ALLOW_REGISTRATION=true
# Client ID OAuth Google (Google Cloud Console > APIs & Services > Credentials).
# Kosongkan untuk menyembunyikan tombol "Masuk dengan Google".
GOOGLE_CLIENT_ID=

# ====== Impor data dari Google Sheet (opsional) ======
# Isi dengan link Google Sheet (Share > "Anyone with the link" > Viewer), atau link CSV dari
# File > Share > Publish to web. Kolom: timestamp, temp1, humid1, tvoc1, temp2, humid2, tvoc2.
SHEET_URL=
SHEET_POLL_SEC=60
# Format tanggal di Sheet: mdy = 10/22/2026, dmy = 22/10/2026
SHEET_DATE_ORDER=mdy
SHEET_TZ_OFFSET=+07:00
# Opsional: hanya impor baris sejak waktu ini
SHEET_IMPORT_SINCE=
